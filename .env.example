# FuelChain Bolivia — environment template (DEMO)
# Copy to .env and fill values. Never commit real secrets.

# --- Database ---
DATABASE_URL=postgresql://fuelchain:fuelchain@localhost:5432/fuelchain?schema=public

# --- API ---
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=FuelChain Bolivia

# --- MQTT / IoT ---
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=fuelchain/tanks

# --- Blockchain ---
# Localhost (default). Hardhat node + pnpm contracts:deploy
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
FUELCHAIN_CONTRACT_ADDRESS=
# Hardhat account #0 — LOCAL DEMO ONLY. Never fund. Never use on HSK Mainnet.
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_FUELCHAIN_CONTRACT_ADDRESS=
NEXT_PUBLIC_BLOCK_EXPLORER_URL=
# Optional alias used by the API if NEXT_PUBLIC_BLOCK_EXPLORER_URL is unset
# BLOCK_EXPLORER_URL=

# HSK Testnet (official: https://docs.hashkeychain.net/docs/Developer-QuickStart)
# Do not commit a real key. Never put a private key in NEXT_PUBLIC_*.
# HSK_TESTNET_RPC_URL=https://testnet.hsk.xyz
# HSK_TESTNET_CHAIN_ID=133
# After a successful HSK deploy, point the app at testnet (copy address from the script output):
# CHAIN_RPC_URL=https://testnet.hsk.xyz
# CHAIN_ID=133
# FUELCHAIN_CONTRACT_ADDRESS=
# NEXT_PUBLIC_CHAIN_ID=133
# NEXT_PUBLIC_FUELCHAIN_CONTRACT_ADDRESS=
# NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet-explorer.hsk.xyz
# BLOCKCHAIN_PRIVATE_KEY=   # testnet deployer only; backend only

# HSK Mainnet (chain 177) — ONLY if the Buildathon track requires it.
# ALLOW_HSK_MAINNET=1
# HSK_MAINNET_RPC_URL=
# See docs/hsk-feria.md

# Idle map consumption (off by default). Set to 1 only for old DEMO burn.
# DEMO_IDLE_CONSUMPTION=0

# --- Document storage (local FS for P0; IPFS = P2) ---
DOCUMENT_STORAGE_PATH=./storage/documents

# --- AI (optional real provider; Mock works without keys) ---
AI_PROVIDER=mock
# OPENAI_API_KEY=
# AI_MODEL=

# --- Auth DEMO (HMAC session tokens) ---
# Required. No fallback. Do not reuse blockchain or QR secrets.
AUTH_SECRET=fuelchain-demo-auth-secret

# --- Custody QR HMAC ---
# Required for issue/accept/sync. Independent of AUTH_SECRET and BLOCKCHAIN_PRIVATE_KEY.
# Fail-fast if missing. Never put this in NEXT_PUBLIC_* or the frontend.
CUSTODY_QR_SECRET=fuelchain-demo-custody-qr-secret
